# Copy to .env (gitignored) and fill in. Values already set in your shell take priority.

# LLM provider: anthropic (default) or openrouter.
HEPTAPOD_PROVIDER=openrouter
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# For HEPTAPOD_PROVIDER=anthropic; or sign in with `ant auth login` instead.
ANTHROPIC_API_KEY=
# Optional: pin a model instead of the provider default.
HEPTAPOD_MODEL=

# Mock backend credentials: throwaway fixtures matching docker-compose.yml.
CRM_API_KEY=crm-dev-key
TICKETING_USER=support
TICKETING_PASSWORD=ticketing-dev-pass
